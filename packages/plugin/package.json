{
  "name": "@getpaseo/plugin",
  "version": "0.7.2",
  "description": "Orqara plugin SDK package",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "source": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "source": "./src/provider.ts",
      "default": "./dist/provider.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "source": "./src/acp.ts",
      "default": "./dist/acp.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "source": "./src/react-native.ts",
      "default": "./dist/react-native.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "source": "./src/host.ts",
      "default": "./dist/host.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "source": "./src/ui.ts",
      "default": "./dist/ui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.7.2",
    "@getpaseo/protocol": "0.7.2",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.18",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@getpaseo/client": "0.7.2",
    "@getpaseo/protocol": "0.7.2",
    "react": "19.2.8",
    "react-native": ">=0.81.5",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
